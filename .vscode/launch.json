{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Run Full Stack (Frontend + Backend)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "console": "integratedTerminal"
    },
    {
      "name": "⚙️ Run Backend API Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server/index.ts"],
      "console": "integratedTerminal",
      "port": 5001
    },
    {
      "name": "🖥️ Run Frontend UI (Vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port=3000", "--host=0.0.0.0"],
      "console": "integratedTerminal",
      "port": 3000
    }
  ]
}

{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-env.js",
    "start": "tsx server/index.ts",
    "dev": "node scripts/dev.js",
    "dev:all": "node scripts/dev.js",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\"",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test server/tests/*.test.ts",
    "test:fabric": "NODE_ENV=test tsx server/tests/runtime/fabric.runtime.test.ts",
    "zip": "node scripts/make-zip.js",
    "package": "node scripts/make-zip.js",
    "package:zip": "node scripts/make-zip.js",
    "package:submission": "bash scripts/package-submission.sh",
    "db:init": "tsx server/db/init_db.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:migrate": "tsx server/db/migrate_legal.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hyperledger/fabric-gateway": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "zod": "^4.5.4",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
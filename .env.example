NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://casevault_app:YOUR_STRONG_PASSWORD@localhost:5432/casevault
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
ENCRYPTION_MASTER_KEY=REPLACE_WITH_RANDOM_SECRET
# Mandatory seed password for initial administrator and police accounts.
# Must be chosen by the administrator and never committed to version control.
INITIAL_SEED_PASSWORD=REPLACE_WITH_STRONG_ADMIN_SEED_PASSWORD

# ============================================================================
# HYPERLEDGER FABRIC 2.5 PERMISSIONED NETWORK CONFIGURATION
# Channel: ecasevault-channel | Chaincode: ecasevault
# ============================================================================

FABRIC_CHANNEL=ecasevault-channel
FABRIC_CHAINCODE=ecasevault

# Default (PoliceOrg) Configuration
FABRIC_MSP_ID=PoliceOrgMSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.police.casevault.police.gov.in
FABRIC_TLS_CERT_PATH=./blockchain/network/organizations/peerOrganizations/police.casevault.police.gov.in/tlsca/tlsca.PoliceOrg-cert.pem
FABRIC_CLIENT_CERT_PATH=./blockchain/network/organizations/peerOrganizations/police.casevault.police.gov.in/users/User1@police.casevault.police.gov.in/msp/signcerts/cert.pem
FABRIC_CLIENT_KEY_PATH=./blockchain/network/organizations/peerOrganizations/police.casevault.police.gov.in/users/User1@police.casevault.police.gov.in/msp/keystore/priv_sk

# Police Organization Identity
POLICE_FABRIC_MSP_ID=PoliceOrgMSP
POLICE_FABRIC_PEER_ENDPOINT=localhost:7051
POLICE_FABRIC_PEER_HOST_ALIAS=peer0.police.casevault.police.gov.in
POLICE_FABRIC_TLS_CERT_PATH=./blockchain/network/organizations/peerOrganizations/police.casevault.police.gov.in/tlsca/tlsca.PoliceOrg-cert.pem
POLICE_FABRIC_CLIENT_CERT_PATH=./blockchain/network/organizations/peerOrganizations/police.casevault.police.gov.in/users/User1@police.casevault.police.gov.in/msp/signcerts/cert.pem
POLICE_FABRIC_CLIENT_KEY_PATH=./blockchain/network/organizations/peerOrganizations/police.casevault.police.gov.in/users/User1@police.casevault.police.gov.in/msp/keystore/priv_sk

# Forensic Science Laboratory (FSL) Identity
FSL_FABRIC_MSP_ID=FSLOrgMSP
FSL_FABRIC_PEER_ENDPOINT=localhost:9051
FSL_FABRIC_PEER_HOST_ALIAS=peer0.fsl.casevault.police.gov.in
FSL_FABRIC_TLS_CERT_PATH=./blockchain/network/organizations/peerOrganizations/fsl.casevault.police.gov.in/tlsca/tlsca.FSLOrg-cert.pem
FSL_FABRIC_CLIENT_CERT_PATH=./blockchain/network/organizations/peerOrganizations/fsl.casevault.police.gov.in/users/User1@fsl.casevault.police.gov.in/msp/signcerts/cert.pem
FSL_FABRIC_CLIENT_KEY_PATH=./blockchain/network/organizations/peerOrganizations/fsl.casevault.police.gov.in/users/User1@fsl.casevault.police.gov.in/msp/keystore/priv_sk

# Cyber Crime Investigation Cell Identity
CYBER_FABRIC_MSP_ID=CyberCellOrgMSP
CYBER_FABRIC_PEER_ENDPOINT=localhost:11051
CYBER_FABRIC_PEER_HOST_ALIAS=peer0.cyber.casevault.police.gov.in
CYBER_FABRIC_TLS_CERT_PATH=./blockchain/network/organizations/peerOrganizations/cyber.casevault.police.gov.in/tlsca/tlsca.CyberCellOrg-cert.pem
CYBER_FABRIC_CLIENT_CERT_PATH=./blockchain/network/organizations/peerOrganizations/cyber.casevault.police.gov.in/users/User1@cyber.casevault.police.gov.in/msp/signcerts/cert.pem
CYBER_FABRIC_CLIENT_KEY_PATH=./blockchain/network/organizations/peerOrganizations/cyber.casevault.police.gov.in/users/User1@cyber.casevault.police.gov.in/msp/keystore/priv_sk
